        "cache_ttl": {
          "description": "how long answers are reused",
          "type": "string"
        },
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "calls_today": {
                "type": "integer"
              },
              "daily_limit": {
                "description": "0 means no daily limit",
                "type": "integer"
              },
              "enabled": {
                "type": "boolean"
              },
              "reason": {
                "description": "why it's disabled",
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "enabled"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "stale_for": {
          "description": "how much longer old answers are kept, to use when a source fails",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "cache_backend",
        "cache_ttl"
      ],
      "type": "object"
    }
