  {
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "List component sources"
    },
    "description": "List the sources: which are enabled (and why not), and how much of each one's daily call budget is used.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "list_sources",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "cache_backend": {
          "description": "memory (lost on restart) or redis (shared, kept across restarts)",
          "type": "string"
