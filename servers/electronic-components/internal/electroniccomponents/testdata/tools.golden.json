          "type": "integer"
        },
        "quantity": {
          "description": "how many you need, for the price comparison (default 1)",
          "type": "integer"
        },
        "query": {
          "description": "keywords or a part number",
          "type": "string"
        },
        "sources": {
          "description": "only these sources: digikey, mouser, jlcpcb; default all enabled",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "query"
