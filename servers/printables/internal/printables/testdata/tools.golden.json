                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "paid": {
                "description": "a Store model, which can't be downloaded here",
                "type": "boolean"
              },
              "published": {
                "type": "string"
              },
              "rating": {
                "description": "average rating out of 5; 0 when unrated",
                "type": "number"
              },
              "ratings": {
                "type": "integer"
              },
              "summary": {
                "type": "string"
              },
              "thumbnail_url": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "rating",
              "ratings",
              "likes",
              "downloads",
              "makes"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "description": "how many models match in all",
          "type": "integer"
