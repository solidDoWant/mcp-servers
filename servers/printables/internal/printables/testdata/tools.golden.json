          "type": "integer"
        },
        "query": {
          "description": "what to search for, e.g. raspberry pi 5 case",
          "type": "string"
        },
        "sort": {
          "description": "result order: best_match (default), popular, latest, rating or makes_count",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
