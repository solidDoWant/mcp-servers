[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Create a SendCutSend part"
    },
    "description": "Add a part to the SendCutSend account from a file and wait for the site to process it. Pass either dxf_text (the content of a DXF file, up to 1 MiB) or upload_url (from get_upload_url, after uploading). Returns the part's ID for quote_part and create_saved_cart, its measured size, and any problems that stop it being priced. If processing takes longer than the wait, the part comes back with processed=false: call get_part later.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dxf_text": {
          "description": "the whole content of a DXF file",
          "type": "string"
        },
        "filename": {
          "description": "the part's file name, shown on the website; with dxf_text it must end in .dxf",
          "type": "string"
        },
        "units": {
          "description": "the drawing's units: in or mm; leave empty to let SendCutSend detect them",
          "type": "string"
        },
        "upload_url": {
          "description": "the upload_url from get_upload_url, after the file was PUT to it",
          "type": "string"
        }
      },
      "required": [
        "filename"
      ],
      "type": "object"
    },
    "name": "create_part",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "description": "in the part's units, squared",
          "type": "number"
        },
        "contours": {
          "description": "closed outlines found, the outer edge included",
          "type": "integer"
        },
        "created": {
          "type": "string"
        },
        "errors": {
          "description": "problems that stop the part being priced",
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "format": {
          "description": "what SendCutSend thinks it is: sheet, tube and so on",
          "type": "string"
        },
        "height": {
          "description": "in the part's units",
          "type": "number"
        },
        "id": {
          "description": "the part ID quote_part and create_saved_cart take",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "possible_formats": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "preview_url": {
          "description": "an image of the part as SendCutSend sees it",
          "type": "string"
        },
        "processed": {
          "description": "false while SendCutSend is still processing the file; call get_part again later",
          "type": "boolean"
        },
        "quotable": {
          "description": "whether the part can be priced: processed and without errors",
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "width": {
          "description": "in the part's units",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "processed",
        "state",
        "quotable",
        "width",
        "height",
        "area",
        "contours"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Create a SendCutSend saved cart"
    },
    "description": "Create a saved cart on the SendCutSend account holding cut-only parts, and return a checkout_url. Give the user the checkout_url: opening it while signed in loads the parts into their cart to review and pay. Nothing is ordered or paid here. The account's own cart must be empty, because SendCutSend builds a saved cart from everything in it; this tool adds its parts, saves, and takes them out again. A saved cart can't be changed afterwards; create another and delete the old one instead.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "description": "1 to 25 lines",
          "items": {
            "additionalProperties": false,
            "properties": {
              "material_sku": {
                "description": "a SKU from list_materials or quote_part",
                "type": "string"
              },
              "part_id": {
                "type": "integer"
              },
              "quantity": {
                "description": "1 to 10000",
                "type": "integer"
              }
            },
            "required": [
              "part_id",
              "material_sku",
              "quantity"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "title": {
          "description": "a name for the cart, shown on the website",
          "type": "string"
        }
      },
      "required": [
        "title",
        "items"
      ],
      "type": "object"
    },
    "name": "create_saved_cart",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "checkout_url": {
          "description": "open while signed in to load the cart for checkout",
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "est_ship_date": {
          "type": "string"
        },
        "id": {
          "description": "the saved cart's ID",
          "type": "integer"
        },
        "in_hand_date": {
          "type": "string"
        },
        "item_count": {
          "type": "integer"
        },
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "material_sku": {
                "type": "string"
              },
              "part_id": {
                "type": "integer"
              },
              "part_name": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              },
              "total_price_usd": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "unit_price_usd": {
                "type": [
                  "null",
                  "number"
                ]
              }
            },
            "required": [
              "part_id",
              "material_sku",
              "quantity"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "reference": {
          "description": "SendCutSend's reference number",
          "type": "string"
        },
        "shipping_estimate_usd": {
          "description": "standard shipping to the account's address; final at checkout",
          "type": [
            "null",
            "number"
          ]
        },
        "subtotal_usd": {
          "description": "parts only, when the cart was made",
          "type": [
            "null",
            "number"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "item_count"
      ],
      "type": "object"
    }
  },
