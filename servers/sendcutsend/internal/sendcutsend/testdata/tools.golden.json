  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Get a SendCutSend upload URL"
    },
    "description": "Get a pre-signed URL to upload a part file (DXF, DWG, AI, EPS or STEP) to, for files you can't pass to create_part inline. Upload with an HTTP PUT of the raw file, e.g. curl -fsS -T part.step '\u003cupload_url\u003e', within 15 minutes, then call create_part with the same upload_url. Uploaded files are publicly readable by anyone who has the URL.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "description": "the file's name with its extension, e.g. bracket.step",
          "type": "string"
        }
      },
      "required": [
        "filename"
      ],
      "type": "object"
    },
    "name": "get_upload_url",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "example": {
          "description": "a command that uploads the file",
          "type": "string"
        },
        "expires_in": {
          "type": "string"
        },
        "upload_url": {
          "description": "PUT the file here, then pass this URL to create_part",
          "type": "string"
        }
      },
      "required": [
        "upload_url",
        "expires_in",
        "example"
      ],
      "type": "object"
    }
  },
