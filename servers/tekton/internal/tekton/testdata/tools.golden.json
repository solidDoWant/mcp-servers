      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "how many runs to return, 1 to 100 (default 20)",
          "type": "integer"
        },
        "namespace": {
          "description": "the namespace the runs are in",
          "type": "string"
        },
        "status": {
          "description": "only runs in this state: running, succeeded, failed, cancelled or pending",
          "type": "string"
        }
      },
      "required": [
        "namespace"
      ],
      "type": "object"
    },
